{
  "expo": {
    "name": "React-Native-UI-Challenge",
    "slug": "React-Native-UI-Challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reactnativeuichallenge",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.sharow.ReactNativeUIChallenge"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c8c0cc72-20dc-42ff-8b84-259b448debdd"
      }
    }
  }
}
